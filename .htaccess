RewriteEngine On
Options -Indexes
DirectoryIndex index.php

# Serve browser-facing assets from /public when the project is hosted from the repo root.
RewriteRule ^(assets|uploads)/(.*)$ public/$1/$2 [L]

# Keep all application routes on the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [QSA,L]
