APP_NAME="Ogun State Political Membership & Election Monitoring System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/elec/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ogun_political
